{
  "name": "fchat",
  "version": "3.0.17",
  "author": "The F-List Team",
  "description": "F-List.net Chat Client",
  "main": "main.js",
  "id": "fchat",
  "license": "MIT",
  "build": {
    "appId": "net.flist.fchat",
    "productName": "F-Chat",
    "artifactName": "F-Chat-${os}-${arch}.${ext}",
    "directories": {
      "app": "app",
      "output": "dist"
    },
    "nativeRebuilder": "parallel",
    "files": [
      "**/*"
    ],
    "asarUnpack": [
      "themes/**/*",
      "sound-themes/**/*"
    ],
    "win": {
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "F-Chat"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "icon": "build/icon.icns",
      "background": "build/dmg.png",
      "contents": [
        {
          "x": 554,
          "y": 110
        },
        {
          "x": 554,
          "y": 344,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 658,
        "height": 498
      }
    },
    "linux": {
      "icon": "build/icon.png",
      "maintainer": "The F-List Team",
      "executableName": "fchat",
      "desktop": {
        "entry": {
          "Name": "F-Chat",
          "Comment": "The F-Chat Client",
          "Terminal": "false",
          "Type": "Application",
          "StartupWMClass": "F-Chat",
          "Categories": "Network;Chat;"
        }
      }
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none"
      ]
    }
  },
  "scripts": {
    "build": "node ../webpack development",
    "build:dist": "node ../webpack production",
    "watch": "node ../webpack watch",
    "start": "electron app",
    "pack": "electron-builder",
    "build:win": "node build/build.mjs --os windows --format nsis",
    "build:linux": "node build/build.mjs --os linux --format deb AppImage",
    "build:mac": "node build/build.mjs --os macos --format dmg zip"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@f-list/vue-ts": "^1.0.3",
    "@fortawesome/fontawesome-free": "^5.9.0",
    "axios": "^0.30.0",
    "bootstrap": "^4.3.1",
    "date-fns": "^1.30.1",
    "electron-log": "^4.4.8",
    "lodash": "^4.17.11",
    "qs": "^6.6.0",
    "raven-js": "^3.27.2",
    "sortablejs": "~1.9.0",
    "tslib": "^2.8.1",
    "vue": "^2.6.8"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.134",
    "@types/node": "16.18.32",
    "@types/sortablejs": "^1.7.2",
    "commander": "^14.0.0",
    "electron": "39.2.7",
    "electron-builder": "^26.3.2"
  },
  "optionalDependencies": {
    "electron-squirrel-startup": "^1.0.0"
  }
}
